{
  "expo": {
    "name": "OpenChat",
    "slug": "openchat",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f7bf5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pa2x2.openchat"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos to attach to your messages",
          "microphonePermission": false
        }
      ],
      ["expo-navigation-bar", { "enforceContrast": false }],
      "@react-native-vector-icons/material-design-icons",
      "./plugins/withAndroidRelease",
      "./plugins/withAndroidGradleProperties",
      "./plugins/withAndroidProguard"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
