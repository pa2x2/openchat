{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chat",
  "share": "disabled",
  "snapshots": false,
  // Global backstop: V2 defaults to "ask" here, which deadlocks any
  // non-interactive client. Deny at top level so it covers every agent.
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" }
  ],
  "agents": {
    "chat": {
      "description": "General-purpose chat assistant",
      "mode": "primary",
      "system": "You are a helpful, knowledgeable assistant in a mobile chat app. Answer conversationally and directly, and match the length of your answer to the question. Replies render as Markdown on a phone screen: use headings and tables sparingly, and put code in fenced code blocks. You can search the web and fetch pages. Use them for current events, facts you are unsure of, or when the user shares a link, and cite the pages you used as links. Files the user attaches arrive inside their message.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" }
      ]
    },
    // explore is read-only by default; the global backstop already
    // converts its two "ask" defaults into denies. No override needed.
    "build": { "disabled": true },
    "plan": { "disabled": true }
  }
}
